{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:critical-atlas:schema:common:0.2",
  "title": "Shared definitions of the atlas data spec v0.2",
  "description": "Descriptions, status objects, keys and value forms shared by every atlas record. Every stored value is a description: a value together with the status that says how it was obtained. Nothing in the atlas is a proof input.",
  "$defs": {
    "schema_version": {
      "description": "Semantic version of the data spec the file follows. Until 1.0.0 only additive changes within 0.2.x.",
      "type": "string",
      "pattern": "^0\\.2\\.[0-9]+$"
    },
    "key": {
      "description": "Entity key: 12 hexadecimal characters of the graph hash, a hyphen, and the ordinal minted when the entity was created (spec section 1.3). Permanent; never reused or renumbered.",
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[1-9][0-9]*$"
    },
    "stratum_key": {
      "type": "string",
      "pattern": "^s-[0-9a-f]{12}-[1-9][0-9]*$"
    },
    "obs_id": {
      "description": "Observation id: o- and 16 hexadecimal characters of a SHA-256 (spec section 7.1).",
      "type": "string",
      "pattern": "^o-[0-9a-f]{16}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ev-[0-9]+$"
    },
    "node_id": {
      "description": "Node of a per-N Morse diagram: n- followed by an entity key, or x- followed by the base key and the rattler count for a rattler extension.",
      "type": "string",
      "pattern": "^(n-[0-9a-f]{12}-[1-9][0-9]*|x-[0-9a-f]{12}-[1-9][0-9]*-n[0-9]+-m[1-9][0-9]*|s-[0-9a-f]{12}-[1-9][0-9]*)$"
    },
    "container": {
      "description": "The space the N points live in. 'sphere' with d means points on the unit sphere S^(d-1) in R^d (kisscrit's d). Other containers are extension points: their id and params are named here, their fields are added later.",
      "type": "object",
      "required": ["id", "d"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "d": {"type": "integer", "minimum": 1},
        "params": {"type": "object"}
      },
      "additionalProperties": false
    },
    "plain_text": {
      "description": "Free text written by the pipeline. The word 'certified' (any case) is not allowed in any free text of the atlas; a viewer may show it only for a level-4 description (spec section 2.4).",
      "type": "string",
      "not": {"pattern": "[Cc][Ee][Rr][Tt][Ii][Ff]"}
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|unknown)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
    },
    "integer_string": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "source": {
      "description": "Where a description comes from: the script or file, the commit it was read or run at, and the software versions. File names are repository-relative; no host, user or private path.",
      "type": "object",
      "required": ["commit"],
      "anyOf": [{"required": ["script"]}, {"required": ["file"]}],
      "properties": {
        "script": {"type": "string"},
        "function": {"type": "string"},
        "file": {"type": "string"},
        "pointer": {"type": "string", "description": "JSON pointer or record index inside file"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"},
        "versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "run_id": {"type": "string"},
        "observation": {"$ref": "#/$defs/obs_id"}
      },
      "additionalProperties": false
    },
    "status": {
      "description": "How a value was obtained. level: 0 numerical (double precision); 1 high-precision (converged, digits stated); 2 interval-verified (outward-rounded enclosure); 3 exact (test-verified): exact algebraic data accepted by an exact computation; 4 checker-accepted: a certificate accepted by the checker named in the cert-checker spec v0.2. method: a label from the draft vocabulary of verification methods (not adopted).",
      "type": "object",
      "required": ["level", "label", "method", "assumption", "source"],
      "properties": {
        "level": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
        "label": {"enum": ["numerical", "high-precision", "interval-verified", "exact (test-verified)", "checker-accepted"]},
        "method": {"enum": ["E", "I", "R", "C", "X", "F", "P", null]},
        "method_vocabulary": {"const": "draft 2026-10-24 (not adopted)"},
        "precision": {
          "type": "object",
          "properties": {
            "digits": {"type": "integer", "minimum": 1},
            "tolerance": {"type": "number", "minimum": 0},
            "residual": {"type": "number", "minimum": 0},
            "interval_width": {"type": "number", "minimum": 0},
            "note": {"$ref": "#/$defs/plain_text"}
          },
          "additionalProperties": false
        },
        "assumption": {"$ref": "#/$defs/plain_text"},
        "source": {"$ref": "#/$defs/source"},
        "checker": {
          "type": "object",
          "required": ["name", "commit", "certificate", "verdict"],
          "properties": {
            "name": {"type": "string"},
            "commit": {"$ref": "#/$defs/commit"},
            "certificate": {"type": "string"},
            "certificate_sha256": {"$ref": "#/$defs/sha256"},
            "verdict": {"const": "accepted"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"level": {"const": 0}}}, "then": {"properties": {"label": {"const": "numerical"}, "method": {"enum": ["F", null]}}}},
        {"if": {"properties": {"level": {"const": 1}}}, "then": {"properties": {"label": {"const": "high-precision"}, "method": {"enum": ["F", null]}}, "required": ["precision"]}},
        {"if": {"properties": {"level": {"const": 2}}}, "then": {"properties": {"label": {"const": "interval-verified"}, "method": {"enum": ["I", "R"]}}}},
        {"if": {"properties": {"level": {"const": 3}}}, "then": {"properties": {"label": {"const": "exact (test-verified)"}, "method": {"enum": ["E", "X"]}}}},
        {"if": {"properties": {"level": {"const": 4}}}, "then": {"properties": {"label": {"const": "checker-accepted"}, "method": {"const": "C"}}, "required": ["checker"]}, "else": {"not": {"required": ["checker"]}}}
      ]
    },
    "real_value_0": {"type": "number"},
    "real_value_1": {
      "type": "object",
      "required": ["decimal", "digits"],
      "properties": {"decimal": {"$ref": "#/$defs/decimal"}, "digits": {"type": "integer", "minimum": 17}},
      "additionalProperties": false
    },
    "real_value_2": {
      "type": "object",
      "required": ["interval"],
      "properties": {
        "interval": {"type": "array", "prefixItems": [{"$ref": "#/$defs/decimal"}, {"$ref": "#/$defs/decimal"}], "items": false, "minItems": 2}
      },
      "additionalProperties": false
    },
    "real_value_3": {
      "description": "A real algebraic number: integer minimal polynomial (coefficients constant term first, as in data/exact/critical-configs-n12.json) and a rational isolating interval containing exactly one root.",
      "type": "object",
      "required": ["minpoly", "isolating_interval"],
      "properties": {
        "minpoly": {"type": "array", "items": {"$ref": "#/$defs/integer_string"}, "minItems": 2},
        "isolating_interval": {"type": "array", "prefixItems": [{"$ref": "#/$defs/rational"}, {"$ref": "#/$defs/rational"}], "items": false, "minItems": 2},
        "closed_form": {"type": "string"},
        "decimal": {"$ref": "#/$defs/decimal"}
      },
      "additionalProperties": false
    },
    "real_description": {
      "description": "A description of one real number. The form of the value follows the level.",
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "id": {"type": "string"},
        "value": true,
        "status": {"$ref": "#/$defs/status"},
        "note": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"properties": {"level": {"const": 0}}}}}, "then": {"properties": {"value": {"$ref": "#/$defs/real_value_0"}}}},
        {"if": {"properties": {"status": {"properties": {"level": {"const": 1}}}}}, "then": {"properties": {"value": {"$ref": "#/$defs/real_value_1"}}}},
        {"if": {"properties": {"status": {"properties": {"level": {"const": 2}}}}}, "then": {"properties": {"value": {"$ref": "#/$defs/real_value_2"}}}},
        {"if": {"properties": {"status": {"properties": {"level": {"const": 3}}}}}, "then": {"properties": {"value": {"$ref": "#/$defs/real_value_3"}}}}
      ]
    },
    "int_description": {
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "id": {"type": "string"},
        "value": {"type": ["integer", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "note": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    },
    "any_description": {
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "id": {"type": "string"},
        "value": true,
        "status": {"$ref": "#/$defs/status"},
        "note": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    },
    "descriptions": {
      "description": "All descriptions of one quantity, in the order they were added. None is overwritten or removed; the best is chosen by the rule of spec section 2.3.",
      "type": "array",
      "minItems": 1
    },
    "edge": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false,
      "minItems": 2
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "image": {
      "description": "A stored image (spec section 4). Deterministic SVG; the label says what it is drawn from.",
      "type": "object",
      "required": ["path", "sha256", "format", "bytes", "drawn_from", "label", "alt"],
      "properties": {
        "path": {"type": "string", "pattern": "^img/[0-9a-z.-]+\\.svg$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"const": "svg"},
        "bytes": {"type": "integer", "minimum": 1},
        "drawn_from": {"type": "string"},
        "label": {"$ref": "#/$defs/plain_text"},
        "alt": {"$ref": "#/$defs/plain_text"},
        "generator": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "generated_by": {
      "type": "object",
      "required": ["script", "commit"],
      "properties": {
        "script": {"type": "string"},
        "commit": {"$ref": "#/$defs/commit"},
        "versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "note": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    }
  }
}
